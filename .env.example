# Copy this file to .env and fill in your keys. .env is gitignored — never
# commit real keys. Three keys cover every hosted service this pack calls.
#
# Cloud sessions (Claude Code on the web): do NOT use this file — add the same names as
# secrets in the environment's settings. Every script reads the environment first.

# Required for sound-design (ElevenLabs SFX + music + ambience generation).
# Get a key at https://elevenlabs.io → Profile → API Keys. Generation spends credits.
ELEVENLABS_API_KEY=

# Optional — Vercel AI Gateway: ONE key for every LLM/whisper call instead of separate
# OpenAI and Gemini keys. Powers video-qa's watch+listen layer (L3) and the cloud whisper
# fallback used by video-qa, hook-splitter and multicam-demo-edit. Create the key at
# https://vercel.com → AI Gateway → API keys. QA still runs its other layers without it.
AI_GATEWAY_API_KEY=
# Model ids are provider/model (GET https://ai-gateway.vercel.sh/v1/models lists them;
# `npm --prefix tools/video-qa run qa:check` verifies these two). Keep the QA model on a
# Gemini id — the family that takes video + audio input.
# VIDEO_QA_MODEL=google/gemini-3.6-flash
# VIDEO_QA_TRANSCRIBE_MODEL=openai/whisper-1

# Optional — kie.ai: generated B-roll, overlays and stills (kie-broll skill; Seedance,
# Kling, Wan, Nano Banana, GPT Image… behind one key). https://kie.ai/api-key
# Prepaid credits; the skill states the per-clip price and asks before each generation.
KIE_API_KEY=

# Optional — Microsoft Graph bearer token (Files.ReadWrite / Sites.ReadWrite.All) for
# video-edit-pipeline/scripts/fetch_media.py: fetching org-only SharePoint/OneDrive links and
# pushing finished masters back to the library. "Anyone with the link" fetches need no token.
# Delegated tokens expire in ~1 h — set it as a session secret when a push is planned.
MS_GRAPH_TOKEN=

# Note: here.now canvas delivery does NOT use this file — its credentials live
# in ~/.herenow/credentials (see the here-now skill / https://here.now/docs).

# Optional — where per-project working folders live (absolute path). Default: outputs/ in this
# pack. Set it when the videos live in another repo; MASTER_CONTEXT.md should say the same.
VIDEO_PROJECTS_DIR=

# Optional — override tool locations when they are not on PATH.
# FFMPEG= FFPROBE= WHISPER_CLI= WHISPER_MODEL= VAD_BIN= VAD_MODEL= VIDEO_QA_CACHE_DIR=
